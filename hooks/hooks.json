{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}\" DEADFISH_PLUGIN_ROOT=\"${DEADFISH_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\" bash \"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}/hooks/scripts/on-protected-write.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}\" DEADFISH_PLUGIN_ROOT=\"${DEADFISH_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\" bash \"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}/hooks/scripts/on-task-completed.sh\"",
            "timeout": 180
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}\" DEADFISH_PLUGIN_ROOT=\"${DEADFISH_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\" bash \"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}/hooks/scripts/on-teammate-idle.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}\" DEADFISH_PLUGIN_ROOT=\"${DEADFISH_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\" bash \"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}/hooks/scripts/on-subagent-stop.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}\" DEADFISH_PLUGIN_ROOT=\"${DEADFISH_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\" bash \"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}/hooks/scripts/on-pre-compact.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}\" DEADFISH_PLUGIN_ROOT=\"${DEADFISH_PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\" bash \"${CLAUDE_PLUGIN_ROOT:-${DEADFISH_PLUGIN_ROOT:-}}/hooks/scripts/on-session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
